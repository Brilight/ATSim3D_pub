# Material information include the following items:
# type: Solid, Fluid, Gas, others(composite, PCM)
# non_linear: nonlinear conductivity or not
# conductivity (w/(m-k)): (base) conductivity for (non)linear material, including three types
#   conductivity (w/(m-k)) = k_iso
#   conductivity (w/(m-k)) = k_h k_v
#   conductivity (w/(m-k)) = k_x k_y k_z
# t_0, alpha: \kappa(T) = conductivity * (t_0/T)**\alpha
# volumetric heat capacity (j/(m3-k))

[Si]
type = Solid
non_linear = False
t_0 = 300 K
alpha = 1.5
conductivity (w/(m-k)) = 140
volumetric heat capacity (j/(m3-k)) = 1.63e6

[Bump]
type = Solid
non_linear = False
conductivity (w/(m-k)) = 10 10 30
volumetric heat capacity (j/(m3-k)) = 3e6

[Substrate]
#ECTC-24
type = Solid
non_linear = False
conductivity (w/(m-k)) = 1.9
volumetric heat capacity (j/(m3-k)) = 1e6

[SiO2]
type = Solid
non_linear = False
conductivity (w/(m-k)) = 2
volumetric heat capacity (j/(m3-k)) = 2.0e6

