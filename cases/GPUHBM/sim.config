# Package information, including:
#   the effective heat transfer coefficient (HTC, unit: W/m²·K) for [NoPackage] 
#   detailed parameters for [AirCooling]/[LuquidCooling] (not supported so far)
[NoPackage]
htc_top = 2000
# Recommended value: 300-30000, depending on the cooling strategy.
htc_bot = 100
# Recommended value: 0-500, depending on thermal insulation and PCB configuration.


# Temperature settings in Kelvin/Celsius.
[Temperature]
ambient = 318.15 K
# Ambient temperature of the environment.
init = 318.15 K
# Init temperature to start iteration.


# Simulation configuration settings.
[Simulation]
number_of_core = 8
# Number of CPU cores to use for parallel computation.

sim_mode = 0
# Simulation mode: 0 for steady-state, 1 for transient simulation.

calc_leakage = 0
# Enable leakage power calculation: 0 for disabled, 1 for enabled.

cycles = 10
# Maximum number of iterations for nonlinear simulation

threshold = 0.05 K
# Convergence threshold (maximum temperature difference between two iterations)

power_type = value
# Type of power input: 'value' for real power values in the power csv file, 'util' for utilization ratio.

power_gran = unit
# Power granularity: 'unit' for unit-level, 'grid' for grid-level.
# For 'unit' type, calculate the max/min/average/weighted_avg temperature over a unit when updating the leakage power.

unit_agg_method = avg
# Method for aggregating unit power: max, min, avg, weighted_avg, enabled only when power_gran=='unit'.
# 'max' for maximum temperature, 'min' for minimum temperature, 'avg' for average temperature,
# 'weighted_avg' for average temperature weighted by volumes of grids in a unit.

calc_kappa_type = vr
# Method for calculating effective conductivity, choose between v, r, vr.
# 'v' for the Voigt bound, 'r' for the Reuss bound, and 'vr' for the hybrid.


# Mesh configuration settings.
[MeshConfig]
rows = 25
cols = 25
# Number of rows and columns in the mesh grid.
# Recommended value: 32-128, depending on simulation resolution.

min_depth = 1
max_depth = 3
# Minimum and Maximum depth for grid refinement.
# Recommended value: 1-2 and 3-6, respectively, depending on simulation requirements.

powerdens_th = 1e5
# Power density threshold for adaptive grid refinement (unit: W/m²).
# Recommended value: 1e4-1e6, depending on power distribution.

max_thickness = 0.001
# Maximum thickness of grids in 'Sink' and 'Bulk' components (meters).
# Recommended value: 1e-4 to 1e-2, depending on layer thickness.

tiers_active = 1
tiers_bulk = 1
tiers_chiplet = 1
# Number of tiers for active/bulk/chiplet layers to improve accuracy.
# Recommended value: 1-4, depending on layer complexity.


tolerance = 1e-2
# Relative tolerance for equality when creating mesh (unit: m).
# Fixed number.


### -------FIXED PARAMETERS BELOW------- ###
fine_grid_num = 2
# Number of fine grids per coarse grid.
grid_expand_factor = 2
# Expansion factor for cooling components.
tol_zero = 1e-12
# Tolerance for zero values in calculations.
ratio_ignore = 0.1e-3
# Ignore blocks with volume ratio smaller than this threshold.


[Solid]
properties = type, non_linear, conductivity (w/(m-k)), volumetric heat capacity (j/(m3-k))
# Material properties must include in the material library, including conductivity and non-linear behavior.
